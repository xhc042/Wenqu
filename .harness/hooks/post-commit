#!/usr/bin/env python
"""
.harness/hooks/post-commit
Post-commit hook:触发 verifier-only 检查。

为什么不是 spawn worker:
    Mavis runtime 的 spawn 通道仅允许 verifier 类型(code-reviewer / tester)。
    producer 类型(developer / prompt-engineer / db-migrator)不会被 spawn。
    git hook 是无 session 的匿名脚本,无法可靠 spawn worker。
    所以本 hook 走务实路线:
        1. 同步跑 pytest -m "not slow"(等价 tester 触发,更快)
        2. 打印 code-reviewer 的 review checklist 提醒
        3. 写入 .harness/.last-commit.json,Mavis 下次会话能读到

安装方法(选其一):
    a. 软链接(git bash / Linux / macOS):
        ln -s ../../.harness/hooks/post-commit .git/hooks/post-commit
    b. 复制:
        cp .harness/hooks/post-commit .git/hooks/post-commit
       Windows PowerShell:
        Copy-Item .harness/hooks/post-commit .git/hooks/post-commit

跳过:
    git commit -m "msg [skip-hook]"

不阻塞 commit:
    本 hook 总是 exit 0。测试失败只打印警告。
"""
import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent.parent
LOG_FILE = REPO_ROOT / ".harness" / ".last-commit.json"


def run(cmd, **kwargs):
    """git 子命令统一封装"""
    return subprocess.run(
        ["git"] + cmd,
        cwd=REPO_ROOT,
        capture_output=True,
        text=True,
        **kwargs,
    )


def get_changed_files():
    """本次 commit 改动的文件列表"""
    try:
        out = run(["diff-tree", "--no-commit-id", "--name-only", "-r", "HEAD"], check=True).stdout
        return [f.strip() for f in out.splitlines() if f.strip()]
    except subprocess.CalledProcessError:
        return []


def get_commit_msg():
    try:
        return run(["log", "-1", "--pretty=%B", "HEAD"], check=True).stdout
    except subprocess.CalledProcessError:
        return ""


def run_tests():
    """跑非 slow 测试(轻量级,等价 tester 触发的子集)"""
    print("[hook] running pytest -m 'not slow' ...")
    try:
        result = subprocess.run(
            ["pytest", "tests/", "-m", "not slow", "-q", "--tb=line", "--no-header"],
            cwd=REPO_ROOT,
            timeout=120,
        )
        if result.returncode == 0:
            print("[hook] tests passed")
            return True
        print(f"[hook] tests FAILED (rc={result.returncode}),详见上方输出")
        return False
    except FileNotFoundError:
        print("[hook] pytest not installed,跳过(请 pip install -r requirements-test.txt)")
        return None
    except subprocess.TimeoutExpired:
        print("[hook] pytest timeout(>120s),跳过")
        return None
    except Exception as e:
        print(f"[hook] pytest error: {e},跳过")
        return None


def check_commit_markers(msg, files):
    """
    检查 commit message 标记(方案 D：强化测试自动触发机制)
    
    验证 commit message 是否包含正确的 [test-added] / [doc-synced] 标记
    如果 app.py 有改动但没有 [test-added],发出警告
    """
    has_app_py = "app.py" in files
    has_test_added = "[test-added]" in msg
    has_doc_synced = "[doc-synced]" in msg
    has_skip_test = "[skip-test]" in msg
    
    warnings = []
    
    # 检查 app.py 改动是否有测试标记
    if has_app_py and not has_test_added and not has_skip_test:
        # 检查是否有新增测试文件
        has_new_test = any(f.startswith("tests/test_") and f.endswith(".py") for f in files)
        if not has_new_test:
            warnings.append(
                "⚠️  [标记检查] app.py 有改动但未标记 [test-added]\n"
                "   → 如果新增了测试,请在 commit message 加 [test-added]\n"
                "   → 如果不需要测试,请加 [skip-test]"
            )
    
    # 检查文档改动是否有文档标记
    has_arch_md = ".harness/docs/architecture.md" in files
    has_code_style_md = ".harness/docs/code-style.md" in files
    if (has_arch_md or has_code_style_md) and not has_doc_synced:
        warnings.append(
            "⚠️  [标记检查] 文档有改动但未标记 [doc-synced]\n"
            "   → 请在 commit message 加 [doc-synced]"
        )
    
    if warnings:
        print("\n" + "=" * 60)
        print("[hook] Commit 标记检查(warning):")
        for w in warnings:
            print(w)
            print()
        print("=" * 60)
        return False
    
    return True


def print_review_checklist(files):
    """打印 code-reviewer 的重点 checklist(对应 .harness/reins/code-reviewer/agent.md)"""
    has_python = any(f.endswith(".py") for f in files)
    has_prompt = any(f.startswith("prompts/") for f in files)
    has_schema = "database.py" in files
    has_static = any(f.startswith("static/") for f in files)
    has_harness = any(f.startswith(".harness/") or f == "AGENTS.md" for f in files)

    triggered = False
    if has_python or has_schema:
        triggered = True
        print("[hook] code-reviewer checklist(Python / schema 改动):")
        print("  - 并发安全:async_tasks 跨请求 / SQLite 并发写 / asyncio.create_task GC")
        print("  - LLM 兜底:每个 llm_client.chat_json 调用是否有 try/except + 降级路径")
        print("  - 资源管理:aiofiles / db.get_conn() 是否正确 close")
        print("  - 边界条件:空文本 / 超长文本 / 非 JSON / 章节数 0")
        print("  - 状态机违规:state_machine 是否绕过 DialogueStateMachine")
    if has_prompt:
        triggered = True
        print("[hook] prompt-engineer checklist(prompt 改动):")
        print("  - 角色语气一致性:8 角色 × 4 深度 = 32 组合")
        print("  - 滑块显式体现:strictness / encouragement / verbosity")
        print("  - 深度档位:deep / dialectical 是否含 critical_angles")
    if has_static:
        triggered = True
        print("[hook] frontend checklist(static/ 改动):")
        print("  - 内联 JS 是否超过 50 行 / 应抽到 .js 文件")
        print("  - 是否有 XSS 风险(用户输入渲染)")
    if has_harness:
        triggered = True
        print("[hook] harness checklist(.harness/ 或 AGENTS.md 改动):")
        print("  - reins 之间是否仍能互相找到(命名一致性)")
        print("  - 是否承认 producer reins runtime 不可 spawn")
    if not triggered:
        print("[hook] 本次改动不触发任何 review checklist(只改了 docs / assets)")


def check_doc_sync(files):
    """
    检查文档同步(方案 C：hook 层面强制文档同步)
    
    如果 app.py 有改动,检查 architecture.md 和 code-style.md 是否同步更新
    如果新增核心函数,检查 tests/ 是否新增对应测试文件
    """
    has_app_py = "app.py" in files
    has_arch_md = ".harness/docs/architecture.md" in files
    has_code_style_md = ".harness/docs/code-style.md" in files
    has_new_test = any(f.startswith("tests/test_") and f.endswith(".py") for f in files)
    
    # 检查新增的测试文件名
    new_test_files = [f for f in files if f.startswith("tests/test_") and f.endswith(".py")]
    
    warnings = []
    
    if has_app_py and not has_arch_md:
        warnings.append(
            "⚠️  [文档同步] app.py 有改动,但 .harness/docs/architecture.md 未同步更新\n"
            "   → 请在'速读模式'或'核心数据流'章节添加说明\n"
            "   → 请在'已知技术债'中标记已修复/待修复项"
        )
    
    if has_app_py and not has_code_style_md:
        # 检查是否涉及编码规范改动
        import subprocess
        try:
            diff_result = subprocess.run(
                ["git", "diff", "HEAD~1", "HEAD", "--", "app.py"],
                cwd=REPO_ROOT,
                capture_output=True,
                text=True,
            )
            if "encoding" in diff_result.stdout or "utf-8" in diff_result.stdout:
                warnings.append(
                    "⚠️  [文档同步] app.py 涉及编码规范改动,.harness/docs/code-style.md 未同步更新\n"
                    "   → 请在'数据库'章节新增'中文环境编码规范'子条目"
                )
        except Exception:
            pass
    
    if has_app_py and not has_new_test:
        warnings.append(
            "⚠️  [测试同步] app.py 有改动,但未检测到新增测试文件\n"
            "   → 请新增 test_<module>.py 覆盖核心函数\n"
            "   → 运行 pytest -m 'not slow' 确保全部通过"
        )
    
    if warnings:
        print("\n" + "=" * 60)
        print("[hook] 文档同步检查(warning):")
        for w in warnings:
            print(w)
            print()
        print("=" * 60)
        return False
    
    return True


def write_log(files, tests_passed):
    """Mavis 下次会话读取此日志,知道有未 review 的 commit"""
    try:
        commit_hash = run(["rev-parse", "HEAD"], check=True).stdout.strip()[:12]
        log = {
            "hash": commit_hash,
            "timestamp": datetime.now().isoformat(),
            "files_changed": files,
            "files_count": len(files),
            "tests_passed": tests_passed,
            "needs_review": any(
                f.endswith(".py") or f.startswith("prompts/") or f == "database.py"
                for f in files
            ),
        }
        LOG_FILE.parent.mkdir(parents=True, exist_ok=True)
        LOG_FILE.write_text(
            json.dumps(log, ensure_ascii=False, indent=2), encoding="utf-8"
        )
        print(f"[hook] log -> {LOG_FILE.relative_to(REPO_ROOT)}")
    except Exception as e:
        print(f"[hook] log 写入失败: {e}")


def main():
    msg = get_commit_msg()
    if "[skip-hook]" in msg:
        print("[hook] [skip-hook] detected, exit")
        return 0

    files = get_changed_files()
    if not files:
        print("[hook] no files changed, exit")
        return 0

    print(f"[hook] {len(files)} files changed:")
    for f in files[:8]:
        print(f"  - {f}")
    if len(files) > 8:
        print(f"  ... and {len(files) - 8} more")
    print()

    tests_passed = run_tests()
    print()
    print_review_checklist(files)
    print()
    
    # 方案 C：文档同步检查
    doc_sync_ok = check_doc_sync(files)
    if not doc_sync_ok:
        print("[hook] ⚠️  文档同步检查未通过,请参照上方 warning 补充")
    print()
    
    # 方案 D：Commit message 标记检查
    marker_ok = check_commit_markers(msg, files)
    if not marker_ok:
        print("[hook] ⚠️  Commit 标记检查未通过,请参照上方 warning 补充")
    print()
    
    write_log(files, tests_passed)

    return 0  # 永远不阻塞 commit


if __name__ == "__main__":
    sys.exit(main())